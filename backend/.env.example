# Copy this file to .env and fill in your values
# NEVER commit .env — only commit this .env.example

ADMIN_SECRET_KEY=your_random_secret_key_here
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me

DATABASE_URL=postgresql://postgres:password@localhost:5432/whatsapp_saas

# Master Google Service Account (paste entire JSON as single line)
GOOGLE_ADMIN_EMAIL=your-email@gmail.com
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-your-secret-here
GOOGLE_OAUTH_REFRESH_TOKEN=your-refresh-token-here
